{
  "name": "mygoui-development-tools",
  "private": true,
  "description": "Pinned agent workflow tools for the native Go library.",
  "scripts": {
    "openspec": "node scripts/openspec.mjs",
    "agents:setup": "node scripts/setup-agents.mjs",
    "spec:check": "node scripts/openspec.mjs validate --all --strict --no-interactive",
    "spec:check-archive": "node scripts/openspec.mjs validate --archived --no-interactive",
    "test": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.15.0",
    "impeccable": "4.8.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
